<Window x:Class="QuickDrawer.AppPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加应用程序"
        Width="460" Height="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource DialogBackground}">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="勾选要添加的应用"
                   Foreground="{DynamicResource TextPrimary}" FontSize="14" FontWeight="SemiBold"
                   Margin="0,0,0,10"/>

        <ListBox x:Name="ListBox" Grid.Row="1"
                 Background="{DynamicResource ControlFill}" Foreground="{DynamicResource TextPrimary}"
                 BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                  VerticalAlignment="Center" Margin="0,0,8,0"/>

                        <Image Grid.Column="1" Width="28" Height="28"
                               Source="{Binding Icon}" Stretch="Uniform"
                               HorizontalAlignment="Left"/>

                        <StackPanel Grid.Column="1" Margin="36,0,0,0">
                            <TextBlock Text="{Binding DisplayName}"
                                       Foreground="{DynamicResource TextPrimary}" FontSize="13"/>
                            <TextBlock Text="{Binding DisplayPath}"
                                       Foreground="{DynamicResource TextMuted}" FontSize="10"
                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock x:Name="StatusText" Grid.Row="2"
                   Foreground="{DynamicResource TextMuted}" FontSize="11"
                   Margin="0,8,0,0" Text="正在扫描…"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="浏览文件…" Width="90" Padding="0,7" Margin="0,0,8,0"
                    Background="Transparent" Foreground="{DynamicResource TextSecondary}" BorderThickness="0"
                    Click="Browse_Click"/>
            <Button Content="添加" Width="80" Padding="0,7" Margin="0,0,8,0"
                    Background="{DynamicResource AccentFill}" Foreground="White" BorderThickness="0"
                    IsDefault="True"
                    Click="Ok_Click"/>
            <Button Content="取消" Width="72" Padding="0,7"
                    Background="Transparent" Foreground="{DynamicResource TextSecondary}" BorderThickness="0"
                    IsCancel="True"
                    Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>