<Window x:Class="QuickDrawer.DrawerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:QuickDrawer"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="QuickDrawer"
        Width="380" Height="600"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="Transparent"
        AllowsTransparency="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <!--
        面板框架（docs/可行性方案.md §8.0，2026-10-18 确认）：
        自上而下三个区域，全部平铺可见，避免二次点击进入功能页面。
          Row 0  顶部：搜索 + 菜单按钮
          Row 1  第一区：常用应用（每行 8 个小图标，名称悬停显示）
          Row 2  第二区：目录路径（自定义分类，可折叠）
          Row 3  第三区：便签 / 剪贴板，标签切换，共用一个显示区域
    -->
    <Window.Resources>
        <local:NoteColorConverter x:Key="NoteColorConverter"/>
        <Style x:Key="SectionHeader" TargetType="Grid">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="10,8,10,2"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 小方块按钮（＋ / ⋮ / 清除 / 标签） -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ControlFill}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ControlFillStrong}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            第三区标签样式。必须是 TargetType="RadioButton" ——
            复用 IconButton（TargetType="Button"）会抛
            "'Button' TargetType does not match type of element 'RadioButton'"。
            选中态用 IsChecked 触发器区分颜色。
        -->
        <Style x:Key="TabButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="8,4" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ControlFill}"/>
                            </Trigger>
                            <!-- 选中态：白字 + 淡背景 -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ControlFill}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            助手页站点标签样式（2026-11-01 用户需求：激活的站点
            "不使用加底色区分，改为浅蓝色字体标记"）。
            从 TabButton 派生，只覆盖选中态：不再给 Border 上底色，
            改用 AccentText 浅蓝字 + SemiBold（纯颜色做选中标记时，
            字重差异让它在浅底/深底上都一眼可辨）。
            悬停态保留淡填充，作为"可点"的反馈，与选中态在视觉上分开。
        -->
        <Style x:Key="ProviderChip" TargetType="RadioButton" BasedOn="{StaticResource TabButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="8,4" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ControlFill}"/>
                            </Trigger>
                            <!-- 选中态：只用浅蓝字，不加底色 -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{x:Null}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 应用图标磁贴（第一区）：无文字，悬停 ToolTip 显示名称（决策 #1） -->
        <Style x:Key="AppTile" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="{Binding Name}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" SnapsToDevicePixels="True">
                            <Image Width="28" Height="28" Stretch="Uniform"
                                   Source="{Binding Icon}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ControlFill}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CategoryHeaderButton" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" Padding="2,2">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            路径项按钮样式（2026-10-19 用户需求：增加列表方式）。
            内容模板由代码侧按 layout.paths 切换：
              icon 模式 → 小图标 + 名称，紧凑
              list 模式 → 图标 + 名称 + 完整路径，一行一个，便于辨认同名项
        -->
        <Style x:Key="PathItemButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="pb" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="4,3" Margin="1">
                            <ContentPresenter HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pb" Property="Background" Value="{DynamicResource ControlFill}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 细滚动条（2026-10-31 用户需求：缩小剪贴板右侧滚动条宽度；同日五次起
             便签列表与目录路径区也统一使用本样式）。
             WPF 默认纵向滚动条宽 17px（SystemParameters.VerticalScrollBarWidth），
             在 400px 的面板里占掉 4% 还带上下两个箭头按钮，太笨重。
             这里改成 6px 无箭头的纯滑块：轨道透明、滑块圆角半透明，
             悬停/拖动时加深。只改视觉，滚动行为仍由 ScrollViewer 驱动。 -->
        <Style x:Key="ThinScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="Transparent" CornerRadius="3">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="tb" Background="{DynamicResource ControlFillStrong}"
                                                        CornerRadius="3" Margin="1,2"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="tb" Property="Opacity" Value="1"/>
                                                        <Setter TargetName="tb" Property="Background" Value="{DynamicResource TextMuted}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="tb" Property="Background" Value="{DynamicResource TextMuted}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!--
            底部仪表盘里"可以点的那一格"（CPU）。外观必须和旁边不可点的两格一致，
            所以模板里只有 ContentPresenter —— 背景透明、无边框，
            只有鼠标悬停时浮出一层 ControlFill 提示"这里能点"。
        -->
        <Style x:Key="DashCell" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="3" Padding="2,1">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ControlFill}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border CornerRadius="8,0,0,8" Background="{DynamicResource PanelBackground}"
            BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1,1,0,1">
        <Grid x:Name="RootGrid" SizeChanged="RootGrid_SizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>                              <!-- 0 搜索 + 菜单 -->
                <RowDefinition Height="Auto"/>                              <!-- 1 常用应用 -->
                <!-- 2 目录路径：默认 Auto（内容决定高度）；拖动分隔条后变为固定像素高度，
                         内容放不下时内部滚动（2026-10-24 需求） -->
                <RowDefinition x:Name="PathAreaRow" Height="Auto"/>
                <!-- 3 便签/剪贴板区顶部的拖动条 -->
                <RowDefinition x:Name="SplitterRow" Height="Auto"/>
                <!-- 4 便签 / 剪贴板：始终填满剩余空间，随分隔条上下移动 -->
                <RowDefinition x:Name="BottomAreaRow" Height="*"/>
                <!-- 2026-11-03 用户需求：最底下一条仪表盘（CPU / 内存 / 网速）。
                     高度 Auto —— 内容就是一行 10 号文字，约 22px。 -->
                <RowDefinition x:Name="DashboardRow" Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ============ 顶部：搜索 + 面板固定 + 菜单 ============ -->
            <Grid Grid.Row="0" Margin="10,10,10,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 2026-11-01（发布前审查 B3）：这里原来是个死控件 —— Text="搜索…"
                     是字面文本，没有 TextChanged、没有过滤逻辑，点进去打字只会得到
                     「搜索…abc」而列表纹丝不动。现在改成真过滤：
                       · Text 由代码控制，占位提示改用独立的 TextBlock 叠在下面
                         （否则占位文本会被当成搜索词的一部分）；
                       · 过滤同时作用于「当前标签页的便签/剪贴板」和「目录路径项」。 -->
                <Grid Grid.Column="0">
                    <TextBox x:Name="SearchBox"
                             Padding="8,5" FontSize="12"
                             Background="{DynamicResource ControlFill}" Foreground="{DynamicResource TextPrimary}"
                             BorderThickness="0"
                             TextChanged="SearchBox_TextChanged"
                             GotKeyboardFocus="SearchBox_GotKeyboardFocus"
                             LostKeyboardFocus="SearchBox_LostKeyboardFocus"
                             AutomationProperties.Name="Search"/>

                    <TextBlock x:Name="SearchPlaceholder"
                               Text="搜索…"
                               Margin="9,0,0,0"
                               Padding="0,5,0,0"
                               FontSize="12"
                               IsHitTestVisible="False"
                               VerticalAlignment="Top"
                               Foreground="{DynamicResource TextMuted}"/>
                </Grid>

                <!-- 面板固定（2026-10-25 需求）：激活后鼠标离开面板也不自动收起 -->
                <Button x:Name="PinPanelButton" Grid.Column="1"
                        Style="{StaticResource IconButton}"
                        Content="📌" Margin="4,0,0,0"
                        FontSize="12" Width="26" Height="24"
                        AutomationProperties.Name="PinPanel"
                        ToolTip="固定面板（鼠标离开也不自动收起）"
                        Click="PinPanelButton_Click"/>

                <!-- 决策 #4：菜单按钮，放置设置/关于/退出 -->
                <Button x:Name="MenuButton" Grid.Column="2"
                        AutomationProperties.Name="Menu"
                        Style="{StaticResource IconButton}"
                        Content="⋮" Margin="4,0,0,0"
                        Click="MenuButton_Click"/>
            </Grid>

            <!-- ============ 第一区：常用应用（每行 8 个，决策 #1） ============ -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Style="{StaticResource SectionHeader}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="应用" Style="{StaticResource SectionTitle}"/>
                    <Button Grid.Column="1" Style="{StaticResource IconButton}"
                            Content="＋" ToolTip="添加应用"
                            Click="AddApp_Click"/>
                </Grid>

<!--
                    M3：应用区拖拽重排。
                    用 ListBox 而不是 ItemsControl —— ListBox 原生支持
                    AllowDrop + DragEnter/DragOver/Drop 的经典重排模式；
                    ItemsControl 的 UniformGrid 不支持拖放。
                    WrapPanel 保持"每行 8 个"的布局（决策 #1）。
                -->
                <ListBox x:Name="AppsList" Grid.Row="1" Margin="6,0,6,4"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AllowDrop="True"
                         PreviewMouseLeftButtonDown="AppsList_PreviewMouseLeftButtonDown"
                         DragEnter="AppsList_DragEnter"
                         DragOver="AppsList_DragOver"
                         Drop="AppsList_Drop">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource AppTile}"
                                    Click="AppTile_Click"
                                    MouseRightButtonDown="AppTile_RightClick"
                                    PreviewMouseLeftButtonDown="AppTile_PreviewMouseLeftButtonDown"
                                    PreviewMouseMove="AppTile_PreviewMouseMove"
                                    AllowDrop="True"
                                    DragOver="AppTile_DragOver"
                                    Drop="AppTile_Drop"
                                    Tag="{Binding}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- ============ 第二区：目录路径（自定义分类） ============ -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- 2026-10-31（五次）修：这里原为 Auto，导致 ScrollViewer 按内容
                         高度量测、永远不被约束，于是目录区"内容放不下时内部滚动"从来没
                         生效过（分隔条改的是外层 PathAreaRow，内容只会溢出压到便签区上）。
                         改成 * 后：外层 Auto 时 star 按内容高度算（行为不变）；
                         外层被分隔条固定成像素时，ScrollViewer 才拿到确定高度、才出滚动条。 -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Style="{StaticResource SectionHeader}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="路径" Style="{StaticResource SectionTitle}"/>

                    <!-- 2026-10-19：列表 / 图标 布局切换 -->
                    <Button x:Name="PathLayoutToggle" Grid.Column="1"
                            AutomationProperties.Name="PathLayout"
                            Style="{StaticResource IconButton}"
                            Click="PathLayoutToggle_Click" Margin="0,0,2,0"
                            ToolTip="切换列表 / 图标显示"/>

                    <Button Grid.Column="2" Style="{StaticResource IconButton}"
                            Content="＋" ToolTip="新建分类 / 添加路径"
                            Click="AddPath_Click"/>
                </Grid>

                <!-- 2026-10-24：目录区高度可由分隔条调节；内容放不下时内部滚动 -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly"
                              Focusable="False"
                              Background="Transparent">
                <!-- 2026-10-31（五次）：目录区也换细滚动条，与剪贴板/便签一致 -->
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}"/>
                </ScrollViewer.Resources>
                <ItemsControl x:Name="CategoriesList" Margin="8,0,8,4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2">
                                <!-- 分类标题行：折叠箭头 + 名称（可接收拖放） -->
                                <Grid AllowDrop="True"
                                      DragOver="Category_DragOver"
                                      Drop="Category_Drop">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- 2026-10-24：箭头给固定宽度，让分类名起始位置确定化。
                                         否则箭头宽度取决于字形渲染，下方添加项图标无法与之精确对齐。 -->
                                    <ToggleButton Grid.Column="0" Width="16"
                                                  Style="{StaticResource CategoryHeaderButton}"
                                                  IsChecked="{Binding Expanded, Mode=TwoWay}"
                                                  Click="CategoryToggle_Click">
                                        <TextBlock Text="{Binding Arrow}" Foreground="{DynamicResource TextMuted}" FontSize="14"
                                                   HorizontalAlignment="Center"/>
                                    </ToggleButton>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}"
                                               Foreground="{DynamicResource TextPrimary}" FontSize="13" FontWeight="Bold"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               Margin="4,0,0,0"
                                               MouseRightButtonDown="Category_RightClick"/>
                                </Grid>

                                <!-- 分类内的路径项：仅展开时可见。
                                     M3：容器级拖放 —— 落在两项之间的空白处也能重排，
                                     且最后一项之下可以插到末尾。 -->
                                <!-- 左边距 15 = 分类名起始(8+16+4=28) − 图标前导(1 Border + 4 Padding=5)，
                                     使添加项图标的左沿与分类名首字对齐（2026-10-24）。 -->
                                <ItemsControl x:Name="PathItemsHost" ItemsSource="{Binding Items}"
                                              Margin="15,2,6,2"
                                              Visibility="{Binding Expanded, Converter={StaticResource BoolToVis}}"
                                              AllowDrop="True"
                                              DragOver="PathItemsHost_DragOver"
                                              Drop="PathItemsHost_Drop">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <!-- 面板方向在 Loaded 时按当前配置决定
                                                 （列表=Vertical 纵向 / 图标=Horizontal）。
                                                 不能只在切换时设置一次：RebuildBindings 会
                                                 销毁并重建面板，新面板会丢失方向状态
                                                 （2026-10-23"点击后变回横排"的根因）。 -->
                                            <WrapPanel x:Name="PathPanel" Loaded="PathPanel_Loaded"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource PathItemButton}"
                                                    ToolTip="{Binding Target}"
                                                    Click="PathItem_Click"
                                                    Loaded="PathItem_Loaded"
                                                    MouseRightButtonDown="PathItem_RightClick"
                                                    PreviewMouseLeftButtonDown="PathItem_PreviewMouseLeftButtonDown"
                                                    PreviewMouseMove="PathItem_PreviewMouseMove"
                                                    AllowDrop="True"
                                                    DragOver="PathItem_DragOver"
                                                    Drop="PathItem_Drop">
                                                <Button.Content>
                                                    <!-- icon 模式：图标 + 名称 -->
                                                    <StackPanel x:Name="IconRow"
                                                              Orientation="Horizontal">
                                                        <!-- 2026-11-06 m08752：图标与文字等高。模板只在 Loaded 替换成
                                                             BuildIconRow 之前短暂存在，这里字号 13 → 方框 17，保持同一规则；
                                                             盘符项由 BuildIconRow 单独用 20。 -->
                                                        <Image Width="17" Height="17" Stretch="Uniform"
                                                               Source="{Binding Icon}"/>
                                                        <TextBlock Text="{Binding Name}"
                                                                   Foreground="{DynamicResource TextPrimary}" FontSize="13"
                                                                   Margin="4,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button.Content>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- ============ 分隔条：上下拖动调节「便签/剪贴板」与「目录区」的高度分配（2026-10-24 用户需求） ============ -->
            <!-- 2026-10-31（六次）用户需求：把这条隐藏的拖拽提示区改成常显，并去掉原来那条短线。
                 改前：整条 10px 带默认 Background=Transparent（平时看不见），只在 IsMouseOver
                 时透出 ControlFill；带内还居中放了一个 44x3 的 BottomSplitterGrip 短线。
                 改后：整条带常显 ControlFill（提示"这里可以拖"），悬停/拖动时加深到
                 ControlFillStrong；短线删除，视觉提示改由整条带本身承担。 -->
            <Border x:Name="BottomSplitter" Grid.Row="3"
                    Height="6" Margin="8,0,8,0"
                    Cursor="SizeNS"
                    ToolTip="上下拖动调整便签/剪贴板区高度（双击恢复自动）"
                    MouseLeftButtonDown="BottomSplitter_MouseLeftButtonDown"
                    MouseMove="BottomSplitter_MouseMove"
                    MouseLeftButtonUp="BottomSplitter_MouseLeftButtonUp">
                <Border.Style>
                    <Style TargetType="Border">
                        <!-- 常显：不再用 Transparent 打底，平时就能看出这里有可拖动的分隔带 -->
                        <Setter Property="Background" Value="{DynamicResource ControlFill}"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ControlFillStrong}"/>
                            </Trigger>
                            <!-- 拖动中保持加深，避免鼠标移出带子时闪回浅色 -->
                            <Trigger Property="IsMouseCaptured" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ControlFillStrong}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>

            <!-- ============ 第三区：便签 / 剪贴板（标签切换，共用一个显示区域） ============ -->
            <Grid Grid.Row="4" Margin="8,4,8,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 标签行：便签 | 剪贴板（带未读角标）| 助手 + 右侧清除按钮 -->
                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <RadioButton x:Name="TabNotes" Grid.Column="0"
                                 Content="📝 便签" IsChecked="True"
                                 GroupName="BottomTabs"
                                 Style="{StaticResource TabButton}"
                                 Checked="TabNotes_Checked"/>

                    <RadioButton x:Name="TabClipboard" Grid.Column="1"
                                 Content="📋 剪贴板"
                                 GroupName="BottomTabs"
                                 Style="{StaticResource TabButton}"
                                 Margin="4,0,0,0"
                                 Checked="TabClipboard_Checked"/>

                    <!-- 智能助手（2026-10-26 需求）：内嵌 DeepSeek / Kimi / 智谱网页端 -->
                    <RadioButton x:Name="TabAssistant" Grid.Column="2"
                                 Content="🤖 助手"
                                 GroupName="BottomTabs"
                                 Style="{StaticResource TabButton}"
                                 Margin="4,0,0,0"
                                 AutomationProperties.Name="TabAssistant"
                                 Checked="TabAssistant_Checked"/>

                    <!-- 决策 #7：剪贴板未读角标 -->
                    <TextBlock x:Name="ClipboardBadge" Grid.Column="1"
                               Text="0" FontSize="9" Foreground="White"
                               Background="{DynamicResource Danger}" Padding="3,0"
                               HorizontalAlignment="Right" VerticalAlignment="Top"
                               Margin="0,-6,10,0" Visibility="Collapsed"/>

                    <!-- 决策 #3：便签栏右侧的清除按钮 -->
                    <Button x:Name="ClearButton" Grid.Column="4"
                            AutomationProperties.Name="ClearList"
                            Style="{StaticResource IconButton}"
                            Content="🗑" ToolTip="清除内容"
                            Click="ClearButton_Click"/>
                </Grid>

                <!-- 共用的显示区域
                     2026-10-31 用户需求：去掉便签/剪贴板/助手区的半透明玻璃底板
                     （原来这里是 SectionBackground + CornerRadius=6 + Padding=8，叠在
                     窗口底色之上就是第二层"玻璃"）。现在背景直接透明，内容贴在
                     PanelBackground 上，与上方"应用""目录路径"两区同底；
                     同时去掉 8px 内边距 —— 便签卡片与助手页 WebView2 因此各宽 16px。 -->
                <Border Grid.Row="1" Background="Transparent" Padding="0">
                    <Grid>
                        <!-- 便签卡片列表（M4） -->
                        <Grid x:Name="NotesPanel">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 卡片列表：卡片内直接编辑，文本变化即保存 -->
                            <ListBox x:Name="NotesList" Grid.Row="0"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ItemsSource="{Binding}"
                                     Focusable="False">
                                <!-- 2026-10-31（五次）：便签列表也换细滚动条，与剪贴板一致 -->
                                <ListBox.Resources>
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}"/>
                                </ListBox.Resources>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,0,6"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <!-- 单张卡片：颜色背景 + 编辑区 + 操作行 -->
                                        <Border Background="{Binding CardBackground}"
                                                CornerRadius="6" Padding="0">
                                            <StackPanel>
                                                <!-- 标题工具栏（2026-11-05 用户需求）：底色比正文深一档。
                                                     圆角只取上方两个角，与外层 6px 圆角对齐；外层 Padding 改成 0，
                                                     由工具栏与正文各自留白，深色条才能顶到卡片左右边缘。
                                                     2026-11-06 用户需求「收窄一点」：内边距 5/1 -> 2/0，
                                                     图标按钮 24 -> 20（色板 20 -> 18、删除 22x20 -> 20x18），
                                                     标题行高度从 30px 降到 22px，可点区域不低于 18px。 -->
                                                <Border Background="{Binding HeaderBackground}"
                                                        CornerRadius="6,6,0,0"
                                                        Padding="6,2,6,0">
                                                <!-- 操作行：名称 / 颜色 / 置顶锁定 / 删除（2026-10-25 重排） -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- 卡片名称（最左）：空时显示占位提示 -->
                                                    <Grid Grid.Column="0" Margin="0,0,4,0" VerticalAlignment="Center">
                                                        <TextBlock Text="卡片名称…"
                                                                   Foreground="{DynamicResource TextSecondary}"
                                                                   FontSize="12" Margin="5,0,0,0"
                                                                   VerticalAlignment="Center"
                                                                   IsHitTestVisible="False"
                                                                   Visibility="{Binding TitlePlaceholder}"/>
                                                        <!-- 卡片标题加粗（2026-10-26 需求 1） -->
                                                        <TextBox Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Background="Transparent" BorderThickness="0"
                                                                 Foreground="{DynamicResource TextPrimary}"
                                                                 FontSize="12" FontWeight="Bold"
                                                                 Height="18" Padding="4,0"
                                                                 VerticalContentAlignment="Center"
                                                                 AutomationProperties.Name="CardTitle"
                                                                 ToolTip="卡片名称"
                                                                 LostFocus="NoteText_LostFocus"/>
                                                    </Grid>

                                                    <!-- 颜色色板 -->
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                HorizontalAlignment="Center">
                                                        <ItemsControl ItemsSource="{x:Static local:NoteStore.Colors}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal"/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Button Style="{StaticResource IconButton}"
                                                                            Width="18" Height="18" Margin="1,0"
                                                                            AutomationProperties.Name="CardColor"
                                                                            Tag="{Binding}"
                                                                            ToolTip="设置卡片颜色"
                                                                            Click="NoteColor_Click">
                                                                        <Button.Content>
                                                                            <Border Background="{Binding Converter={StaticResource NoteColorConverter}}"
                                                                                    CornerRadius="2"
                                                                                    Width="8" Height="8"/>
                                                                        </Button.Content>
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>

                                                    <!-- 置顶 + 锁定：锁定后不被单卡删除、也不被"清除全部"清掉 -->
                                                    <Button Grid.Column="2"
                                                            Content="{Binding PinGlyph}"
                                                            FontSize="11" Width="20" Height="20"
                                                            Margin="2,0"
                                                            ToolTip="{Binding PinToolTip}"
                                                            AutomationProperties.Name="PinCard"
                                                            Tag="{Binding}"
                                                            Click="NotePin_Click">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                                <Setter Property="Opacity" Value="0.55"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Pinned}" Value="True">
                                                                        <Setter Property="Opacity" Value="1"/>
                                                                        <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>

                                                    <!-- 删除 -->
                                                    <Button Grid.Column="3"
                                                            Style="{StaticResource IconButton}"
                                                            Content="✕" FontSize="11"
                                                            Width="20" Height="18"
                                                            Opacity="{Binding DeleteOpacity}"
                                                            ToolTip="{Binding DeleteToolTip}"
                                                            AutomationProperties.Name="DeleteCard"
                                                            Tag="{Binding}"
                                                            Click="NoteDelete_Click"/>
                                                </Grid>
                                                </Border>

                                                <!-- 文本区（2026-10-26 需求 1：加大段落间距）
                                                     背景：WPF 的 TextBox 没有 LineHeight 属性（MC3072 编译失败），
                                                     所以读写分离 ——
                                                       阅读态：TextBlock，LineHeight=20 真正拉开行距；
                                                       编辑态：TextBox，点击文字后显示并聚焦。
                                                     两者共用同一 Text 绑定，编辑态失焦即落盘并切回阅读态。
                                                     2026-11-05：外层卡片 Padding 归零后，正文留白改由这里的 Margin 提供
                                                     （左侧 6 与标题栏 Padding 的 6 对齐），否则文字会贴到卡片边缘。 -->
                                                <Grid Margin="6,4,6,6">
                                                    <TextBlock x:Name="NoteBodyText"
                                                               Text="{Binding Text}"
                                                               Tag="NoteBodyDisplay"
                                                               TextWrapping="Wrap"
                                                               Background="Transparent"
                                                               Foreground="{DynamicResource TextPrimary}"
                                                               FontSize="{DynamicResource NoteBodyFontSize}"
                                                               LineHeight="{DynamicResource NoteBodyLineHeight}"
                                                               LineStackingStrategy="BlockLineHeight"
                                                               MinHeight="34"
                                                               MaxHeight="{DynamicResource NoteBodyMaxHeight}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Padding="2,3,2,3"
                                                               Cursor="IBeam"
                                                               MouseLeftButtonDown="NoteBodyText_MouseDown"/>

                                                    <TextBox x:Name="NoteBodyEditor"
                                                             Tag="NoteBody"
                                                             Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Background="Transparent" BorderThickness="0"
                                                             Foreground="{DynamicResource TextPrimary}"
                                                             FontSize="{DynamicResource NoteBodyFontSize}"
                                                             TextWrapping="Wrap"
                                                             AcceptsReturn="True"
                                                             MinHeight="34"
                                                             MaxHeight="{DynamicResource NoteBodyMaxHeight}"
                                                             Padding="2,3,2,3"
                                                             VerticalScrollBarVisibility="Auto"
                                                             Visibility="Collapsed"
                                                             LostFocus="NoteBodyEditor_LostFocus"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- 空状态提示 -->
                            <TextBlock x:Name="NotesEmpty" Grid.Row="0"
                                       Foreground="{DynamicResource TextMuted}" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextAlignment="Center" Visibility="Collapsed"
                                       Text="还没有便签卡片&#10;点击下方＋新建一张"/>

                            <!-- 底部：添加按钮 -->
                            <!-- 2026-11-01：原本套 IconButton（该 Style 写死 Width=24），
     "＋ 新建便签" 字形包围盒约 46px，文字被裁掉。
     改成自适宽度，点击区域同时提到 32px 高。 -->
<Button x:Name="AddNoteButton" Grid.Row="1"
                                    Style="{StaticResource IconButton}" Width="Auto" MinWidth="112" Height="32"
                                    Content="＋ 新建便签" FontSize="11"
                                    Margin="0,4,0,0"
                                    ToolTip="新建一张便签卡片"
                                    Click="AddNote_Click"/>
                        </Grid>

                        <!-- 剪贴板历史列表（M2） -->
                        <Grid x:Name="ClipboardPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ListBox x:Name="ClipboardList" Grid.Row="0"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource TextPrimary}" FontSize="12"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     PreviewMouseLeftButtonUp="ClipboardList_PreviewMouseLeftButtonUp">
                                <!-- 2026-10-31：剪贴板列表换细滚动条（当日五次后便签列表、目录区也一并统一） -->
                                <ListBox.Resources>
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}"/>
                                </ListBox.Resources>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="2"/>
                                        <Setter Property="Margin" Value="0,1"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Preview}"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <!-- 图片条目：直接显示缩略图，而不是“图片”两个字 -->
                                                <Border x:Name="ThumbBox"
                                                        Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVis}}"
                                                        HorizontalAlignment="Left" Margin="0,1,0,2"
                                                        CornerRadius="3" ClipToBounds="True"
                                                        Background="{DynamicResource AccentSoft}">
                                                    <Image Source="{Binding Thumbnail}"
                                                           Stretch="Uniform" StretchDirection="DownOnly"
                                                           MaxWidth="88" MaxHeight="56"
                                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Border>

                                                <!-- Word / Excel 表格：画成迷你表格，而不是只显示第一个单元格 -->
                                                <Border x:Name="TableBox"
                                                        Visibility="{Binding HasTable, Converter={StaticResource BoolToVis}}"
                                                        HorizontalAlignment="Left" Margin="0,1,0,2"
                                                        BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1"
                                                        CornerRadius="2" ClipToBounds="True">
                                                    <ItemsControl ItemsSource="{Binding TableRows}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <ItemsControl ItemsSource="{Binding}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <StackPanel Orientation="Horizontal"/>
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border BorderBrush="{DynamicResource PanelBorder}"
                                                                                    BorderThickness="0,0,1,1" Padding="4,2">
                                                                                <TextBlock Text="{Binding}"
                                                                                           Foreground="{DynamicResource TextPrimary}"
                                                                                           FontSize="10" MaxWidth="72"
                                                                                           TextTrimming="CharacterEllipsis"/>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Border>

                                                <!-- 文本预览：有缩略图 / 表格时不再占地方 -->
                                                <TextBlock x:Name="PreviewText" Text="{Binding Preview}"
                                                           Foreground="{DynamicResource TextPrimary}" FontSize="12"
                                                           TextWrapping="Wrap" MaxHeight="34"
                                                           TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasThumbnail}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding HasTable}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <TextBlock Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="0,2,0,0">
                                                    <Run Text="{Binding SourceApp}"/>
                                                    <Run Text=" · "/>
                                                    <Run Text="{Binding CreatedAt, StringFormat=HH:mm}"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- 锁定按钮：锁定 = 置顶 + 不被容量清理 / 清除全部时保留 -->
                                            <Button Grid.Column="1" x:Name="PinButton"
                                                    Width="24" Height="24" FontSize="11"
                                                    Tag="{Binding Id}"
                                                    Click="PinClip_Click">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                        <Setter Property="Content" Value="📌"/>
                                                        <Setter Property="Opacity" Value="0.55"/>
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="ToolTip" Value="锁定（固定并避免被清理）"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Pinned}" Value="True">
                                                                <Setter Property="Content" Value="🔒"/>
                                                                <Setter Property="Opacity" Value="1"/>
                                                                <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
                                                                <Setter Property="ToolTip" Value="已锁定，再次点击解锁"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock x:Name="ClipboardEmpty" Grid.Row="0"
                                   Foreground="{DynamicResource TextMuted}" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextAlignment="Center" Visibility="Collapsed"
                                   Text="还没有剪贴板记录&#10;复制点东西就会出现在这里"/>
                        </Grid>

                        <!-- 智能助手页（2026-10-26 需求）：单个 WebView2 实例，
                             切换站点只是 Navigate，不重建内核 -->
                        <Grid x:Name="AssistantPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,4" LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                    <RadioButton x:Name="ChipDeepSeek" Tag="deepseek" Content="DeepSeek"
                                                 GroupName="AssistantProvider"
                                                 Style="{StaticResource ProviderChip}"
                                                 AutomationProperties.Name="ChipDeepSeek"
                                                 Checked="AssistantChip_Checked"/>
                                    <!-- 2026-10-31 用户需求：千问插在 DeepSeek 右侧 -->
                                    <RadioButton x:Name="ChipQwen" Tag="qwen" Content="千问"
                                                 GroupName="AssistantProvider"
                                                 Style="{StaticResource ProviderChip}"
                                                 Margin="4,0,0,0"
                                                 AutomationProperties.Name="ChipQwen"
                                                 Checked="AssistantChip_Checked"/>
                                    <RadioButton x:Name="ChipKimi" Tag="kimi" Content="Kimi"
                                                 GroupName="AssistantProvider"
                                                 Style="{StaticResource ProviderChip}"
                                                 Margin="4,0,0,0"
                                                 AutomationProperties.Name="ChipKimi"
                                                 Checked="AssistantChip_Checked"/>
                                    <RadioButton x:Name="ChipGlm" Tag="chatglm" Content="智谱"
                                                 GroupName="AssistantProvider"
                                                 Style="{StaticResource ProviderChip}"
                                                 Margin="4,0,0,0"
                                                 AutomationProperties.Name="ChipGlm"
                                                 Checked="AssistantChip_Checked"/>
                                </StackPanel>

                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Button x:Name="AssistantBackButton" Style="{StaticResource IconButton}"
                                            Content="◀" Width="22" FontSize="10" ToolTip="后退"
                                            AutomationProperties.Name="AssistantBack"
                                            Click="AssistantBack_Click"/>
                                    <Button x:Name="AssistantForwardButton" Style="{StaticResource IconButton}"
                                            Content="▶" Width="22" FontSize="10" ToolTip="前进"
                                            AutomationProperties.Name="AssistantForward"
                                            Click="AssistantForward_Click"/>
                                    <Button x:Name="AssistantReloadButton" Style="{StaticResource IconButton}"
                                            Content="⟳" Width="22" FontSize="12" ToolTip="刷新"
                                            AutomationProperties.Name="AssistantReload"
                                            Click="AssistantReload_Click"/>
                                    <Button x:Name="AssistantWidenButton" Style="{StaticResource IconButton}"
                                            Content="↔" Width="22" FontSize="12"
                                            AutomationProperties.Name="AssistantWiden"
                                            ToolTip="加宽面板（仅助手页生效）"
                                            Click="AssistantWiden_Click"/>
                                    <Button x:Name="AssistantBrowserButton" Style="{StaticResource IconButton}"
                                            Content="🌐" Width="22" FontSize="10"
                                            AutomationProperties.Name="AssistantBrowser"
                                            ToolTip="在系统浏览器中打开当前页"
                                            Click="AssistantBrowser_Click"/>
                                    <!-- 2026-11-01 五次需求：截图提问。放在最右，
                                         与"打开浏览器"这类出口按钮区分开（它是入口）。 -->
                                    <Button x:Name="AssistantShotButton" Style="{StaticResource IconButton}"
                                            Content="⛶" Width="22" FontSize="12"
                                            AutomationProperties.Name="AssistantShot"
                                            ToolTip="截图提问（框选屏幕区域，再输入提示词发送）"
                                            Click="AssistantShot_Click"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- 站点常驻（2026-10-29）：WebView2 由 AssistantService 按站点动态建到这个宿主里，
                                 切站点只切 Visibility，页面不再重新加载。状态提示层用 ZIndex 压在最上面。 -->
                            <Grid x:Name="AssistantHost" Grid.Row="1">
                                <TextBlock x:Name="AssistantStatus"
                                           Panel.ZIndex="10"
                                           Text="首次打开助手页会加载网页（约 1–3 秒）"
                                           Foreground="{DynamicResource TextMuted}"
                                           FontSize="12" TextWrapping="Wrap"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextAlignment="Center" Margin="12,0"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============ 底部仪表盘（2026-11-03 用户需求） ============
                 "在面板的最底下我想要一行仪表盘，显示 cpu/内存/网速/温度，
                  点击 cpu 打开任务管理器"

                 数值由 DashboardSampler 每秒采一次（UI 线程上的 DispatcherTimer，
                 但采样本身全是微秒级 P/Invoke，不会卡界面）。

                 温度已于 2026-11-04 按用户要求去掉：本机 ACPI 不向系统提供
                 热区温度，那一格永远显示「—」，占位没有意义。 -->
            <Border Grid.Row="5"
                    Background="Transparent"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource PanelBorder}"
                    Padding="10,5,10,7"
                    AutomationProperties.Name="Dashboard">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1.5*"/>
                    </Grid.ColumnDefinitions>

                    <!-- CPU：唯一可点的一格 -->
                    <Button x:Name="DashCpu"
                            Grid.Column="0"
                            Style="{StaticResource DashCell}"
                            AutomationProperties.Name="DashCpu"
                            ToolTip="点击打开任务管理器"
                            Click="DashCpu_Click">
                        <TextBlock TextTrimming="CharacterEllipsis">
                            <Run Text="CPU" Foreground="{DynamicResource TextMuted}"/>
                            <Run x:Name="DashCpuRun" Text=" --" Foreground="{DynamicResource TextPrimary}"/>
                        </TextBlock>
                    </Button>

                    <!-- 内存 -->
                    <TextBlock x:Name="DashMem"
                               Grid.Column="1"
                               Margin="2,1,0,0"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis">
                        <Run Text="内存" Foreground="{DynamicResource TextMuted}"/>
                        <Run x:Name="DashMemRun" Text=" --" Foreground="{DynamicResource TextPrimary}"/>
                    </TextBlock>

                    <!-- 网速 -->
                    <TextBlock x:Name="DashNet"
                               Grid.Column="2"
                               Margin="2,1,0,0"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis">
                        <Run Text="网速" Foreground="{DynamicResource TextMuted}"/>
                        <Run x:Name="DashNetRun" Text=" --" Foreground="{DynamicResource TextPrimary}"/>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
