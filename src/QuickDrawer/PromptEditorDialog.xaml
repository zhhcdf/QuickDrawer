<Window x:Class="QuickDrawer.PromptEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickDrawer 自定义提示词"
        Width="440" Height="330"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{DynamicResource DialogBackground}"
        Loaded="Window_Loaded">

    <!--
        悬浮条「发送」按钮弹出的编辑器（2026-10-31 需求）。
        内容就是 config.assistant.customPrompt，改完点确定才发，
        点确定时把改动回写配置（下次再点「发送」还是这句）。
    -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="发送给助手（这句会拼在选中内容前面）"
                   Foreground="{DynamicResource TextPrimary}" FontSize="13" FontWeight="SemiBold"
                   Margin="0,0,0,8"/>

        <TextBox x:Name="PromptBox" Grid.Row="1"
                 Background="{DynamicResource ControlFillStrong}" Foreground="{DynamicResource TextPrimary}"
                 BorderThickness="0" Padding="8,6" FontSize="13"
                 TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 AutomationProperties.Name="CustomPromptBox"/>

        <TextBlock x:Name="SelectionHint" Grid.Row="2"
                   Text="" Foreground="{DynamicResource TextMuted}" FontSize="11"
                   Margin="0,8,0,0" TextWrapping="Wrap" MaxHeight="48"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="确定发送" Width="92" Padding="0,7" Margin="0,0,8,0"
                    Background="{DynamicResource AccentFill}" Foreground="White" BorderThickness="0"
                    AutomationProperties.Name="PromptOk"
                    IsDefault="True"
                    Click="Ok_Click"/>
            <Button Content="取消" Width="72" Padding="0,7"
                    Background="Transparent" Foreground="{DynamicResource TextSecondary}" BorderThickness="0"
                    AutomationProperties.Name="PromptCancel"
                    IsCancel="True"
                    Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
