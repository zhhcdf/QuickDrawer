<Window x:Class="QuickDrawer.CategoryPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择分类"
        Width="320" Height="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource DialogBackground}">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="添加到哪个分类？"
                   Foreground="{DynamicResource TextPrimary}" FontSize="14" FontWeight="SemiBold"
                   Margin="0,0,0,10"/>

        <ListBox x:Name="CategoryList" Grid.Row="1"
                 Background="{DynamicResource ControlFill}" Foreground="{DynamicResource TextPrimary}"
                 BorderThickness="0">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="8,6"/>
                    <Setter Property="Margin" Value="0,1"/>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="新建分类…" Width="92" Padding="0,7" Margin="0,0,8,0"
                    Background="Transparent" Foreground="{DynamicResource TextSecondary}" BorderThickness="0"
                    Click="New_Click"/>
            <Button Content="确定" Width="72" Padding="0,7" Margin="0,0,8,0"
                    Background="{DynamicResource AccentFill}" Foreground="White" BorderThickness="0"
                    IsDefault="True"
                    Click="Ok_Click"/>
            <Button Content="取消" Width="72" Padding="0,7"
                    Background="Transparent" Foreground="{DynamicResource TextSecondary}" BorderThickness="0"
                    IsCancel="True"
                    Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>