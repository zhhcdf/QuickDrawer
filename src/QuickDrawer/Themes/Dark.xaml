<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        深色主题（跟随系统）。
        2026-10-22 用户反馈"默认的黑色主题太暗了"：
        底色从 #1F1F24 提亮到 #2B2B33，卡片/分区底同步提亮，
        保持深色观感但不发黑。
    -->

    <!-- 窗体与分区底色 -->
    <SolidColorBrush x:Key="PanelBackground" Color="#F52B2B33"/>
    <SolidColorBrush x:Key="PanelBorder" Color="#22FFFFFF"/>

    <!--
        对话框底色（2026-11-01）：设置页 / 自定义提示词编辑器这类普通窗口用。
        PanelBackground 是 96% 不透明（#F5），主面板靠 AllowsTransparency 透出
        桌面才达到观感；普通窗口没有透明层，半透明笔刷会被合成到黑底上而发暗。
        这里给同一个颜色的全不透明版本，观感与主面板一致。
    -->
    <SolidColorBrush x:Key="DialogBackground" Color="#FF2B2B33"/>

    <!-- 控件底（按钮 hover 等） -->
    <SolidColorBrush x:Key="ControlFill" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="ControlFillStrong" Color="#3DFFFFFF"/>

    <!-- 强调文字（2026-11-01）：助手页激活站点用浅蓝字标记，不加底色。
         深色主题背景是 #2B2B33，用亮一些的蓝保证对比度。 -->
    <SolidColorBrush x:Key="AccentText" Color="#FF6FB4FF"/>

    <!-- 危险/警示色（2026-11-01）：未读角标等。
         白字在此红上对比度 ~4.3:1，比原来的 #E05555（3.9:1）好。 -->
    <SolidColorBrush x:Key="Danger" Color="#FFD93F3F"/>

    <!-- 选中态浅底（置顶/锁定按钮） -->
    <SolidColorBrush x:Key="AccentSoft" Color="#3389B4FA"/>

    <!-- 主按钮填充（统一品牌蓝）：白字 5.2:1。 -->
    <SolidColorBrush x:Key="AccentFill" Color="#FF2F6BC0"/>

    <!-- 文字 -->
    <SolidColorBrush x:Key="TextPrimary" Color="#FFF0F0F0"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#FFC8C8C8"/>
    <SolidColorBrush x:Key="TextMuted" Color="#FF9A9A9A"/>

    <!-- 便签卡片色板（深色底） -->
    <SolidColorBrush x:Key="NoteYellow" Color="#4A4230"/>
    <SolidColorBrush x:Key="NoteGreen" Color="#2E4A34"/>
    <SolidColorBrush x:Key="NoteBlue" Color="#2E3A52"/>
    <SolidColorBrush x:Key="NotePink" Color="#4A2E3A"/>
    <SolidColorBrush x:Key="NoteGray" Color="#3A3A40"/>

    <!-- 便签卡片标题工具栏底色（2026-11-05 用户需求：比正文底色深一点）
         取上面对应卡片色按 0.85 压暗，保持同一色相 —— 卡片主体仍用 Note* 键，
         两者只在明度上差一档，切换卡片颜色时标题栏跟着变。 -->
    <SolidColorBrush x:Key="NoteYellowHeader" Color="#3F3829"/>
    <SolidColorBrush x:Key="NoteGreenHeader" Color="#273F2C"/>
    <SolidColorBrush x:Key="NoteBlueHeader" Color="#273146"/>
    <SolidColorBrush x:Key="NotePinkHeader" Color="#3F2731"/>
    <SolidColorBrush x:Key="NoteGrayHeader" Color="#313136"/>
</ResourceDictionary>