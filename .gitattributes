# 统一换行符：仓库内一律存 LF，避免 Windows 上 core.autocrlf 造成
# 「整个文件都改了」的假 diff（首次提交 168 个文件时尤其致命）。
#
# 注意：本机 git 配置是 core.autocrlf=true，若不设 text=auto，git 会把工作区
# 的 LF 当 CRLF 处理，导致同一文件在不同机器上反复来回改。
* text=auto eol=lf

# ---- 明确按文本处理的（给 diff / blame 用正确算法）----
*.cs        text diff=csharp
*.xaml      text
*.csproj    text
*.sln       text eol=crlf
*.props     text
*.targets   text
*.manifest  text
*.config    text
*.json      text
*.md        text
*.yml       text
*.yaml      text
*.ps1       text
*.py        text
*.txt       text

# ---- 二进制：不做换行符转换，也不做文本 diff ----
*.png       binary
*.jpg       binary
*.jpeg      binary
*.ico       binary
*.gif       binary
*.webp      binary
*.zip       binary
*.exe       binary
*.dll       binary
*.pdb       binary
*.snk       binary
